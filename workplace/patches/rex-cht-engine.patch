+byte MainMenu::chtLabelColor(int itemIndex) const {
+	MSprite *spr = _menuItems[itemIndex]->getFrame(0);
+	const byte trans = spr->getTransparencyIndex();
+
+	// 取原圖用得最多的非透明色。選項的字是實心色塊加一圈暗邊，
+	// 主體一定壓過描邊，所以「最常出現」就是字色。
+	int hist[256];
+	for (int i = 0; i < 256; ++i)
+		hist[i] = 0;
+
+	const byte *pix = (const byte *)spr->getPixels();
+	if (!pix || spr->w <= 0 || spr->h <= 0) {
+		debug(2, "[CHT] 選單項 %d 沒有像素可取色（pix=%p %dx%d）",
+			itemIndex, (const void *)pix, spr->w, spr->h);
+		return (byte)0xFF;
+	}
+	const int pitch = spr->pitch;
+	for (int y = 0; y < spr->h; ++y) {
+		const byte *p = pix + (size_t)y * pitch;
+		for (int x = 0; x < spr->w; ++x) {
+			if (p[x] != trans)
+				++hist[p[x]];
+		}
+	}
+
+	int best = -1, bestCount = 0;
+	for (int i = 0; i < 256; ++i) {
+		if (hist[i] > bestCount) {
+			bestCount = hist[i];
+			best = i;
+		}
+	}
+	debug(2, "[CHT] 選單項 %d 取色 index=%d（%d 個像素，透明色=%d）",
+		itemIndex, best, bestCount, trans);
+	return (best < 0) ? (byte)0xFF : (byte)best;
+}
+
+void MainMenu::drawChtLabels() {
+	ChtSupport *cht = _vm->_cht;
+	if (!cht || !cht->enabled() || _chtLabelsDrawn)
+		return;
+
+	Scene &scene = _vm->_game->_scene;
+
+	// [雷] 先把每一項要用的東西（座標、字色）算完，**再**收 sprite。
+	// SpriteSlots::reset() 的預設參數是 reset(true)，那會連
+	// `_scene._sprites.clear()` 一起做 —— 而那個 clear() 會 delete 掉
+	// 陣列裡每一個 SpriteAsset，包含 _menuItems[]。收完再去 getFrame() 就是
+	// use-after-free：讀回來的 w/h 是 2386x-8892 這種垃圾值，然後 segfault。
+	struct Label { int x, y; byte color; const Common::String *text; };
+	Label labels[6];
+	int count = 0;
+
+	for (int i = 0; i < 6; ++i) {
+		if (i == 4 && !shouldShowQuotes())
+			continue;
+
+		const Common::String *tr = cht->lookup(Common::String::format("menu:%d", i));
+		if (!tr)
+			continue;                       // 沒譯文就讓那一項留白，不要畫半套
+
+		MSprite *frame0 = _menuItems[i]->getFrame(0);
+		const int x = frame0->_offset.x - (frame0->w / 2);
+		const int yTop = frame0->_offset.y - frame0->h + DIALOG_TOP;
+		// 字模 15px 高（640 空間）＝ 320 空間的 7.5，跟選項高度置中對齊
+		const int y = yTop + (frame0->h - cht->glyphHeight() / MADS_DISPLAY_SCALE) / 2;
+
+		labels[count].x = x;
+		labels[count].y = y;
+		labels[count].color = chtLabelColor(i);
+		labels[count].text = tr;
+		++count;
+	}
+
+	// 英文選項是 sprite，中文要蓋掉它就得先把它收走 —— 背景是星空，
+	// 沒辦法拿一塊純色補上去。收 sprite 之後畫面自然回到背景圖，
+	// 中文再畫到文字層。原本的逐項淡入動畫在這之前已經跑完了。
+	// reset(false)：只清 slots，不要動 _scene._sprites 裡的 asset。
+	scene._spriteSlots.reset(false);
+	scene._spriteSlots.fullRefresh();
+
+	for (int i = 0; i < count; ++i)
+		cht->drawToLayer(_vm->_screen, labels[i].x, labels[i].y,
+			*labels[i].text, labels[i].color);
+
+	_chtLabelsDrawn = true;
+	_redrawFlag = true;
+}
