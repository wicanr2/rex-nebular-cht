+ */
+
+#include "common/file.h"
+#include "common/textconsole.h"
+#include "common/debug.h"
+#include "mads/cht.h"
+#include "mads/screen.h"
+
+namespace MADS {
+
+#define CHT_FONT_FILE  "rex_big5.fnt"
+#define CHT_TABLE_FILE "rex_cht.tsv"
+#define CHT_FONT_MAGIC "RXCF"
+
+ChtSupport::ChtSupport() : _enabled(false), _glyphW(0), _glyphH(0), _bytesPerRow(0),
+		_count(0), _codes(nullptr), _glyphs(nullptr) {
+}
+
+ChtSupport::~ChtSupport() {
+	delete[] _codes;
+	delete[] _glyphs;
+}
+
+bool ChtSupport::load() {
+	if (!loadFont(CHT_FONT_FILE)) {
+		// 沒有中文字型就是玩家沒裝中文化，維持英文，不是錯誤
+		return false;
+	}
+	if (!loadTable(CHT_TABLE_FILE)) {
+		warning("[CHT] 找到 %s 卻讀不到 %s，維持英文", CHT_FONT_FILE, CHT_TABLE_FILE);
+		return false;
+	}
+
+	_enabled = true;
+	debug(1, "[CHT] 中文化啟用：字型 %d 字 (%dx%d)，替換表 %d 筆",
+		_count, _glyphW, _glyphH, _table.size());
+	return true;
+}
+
+bool ChtSupport::loadFont(const Common::String &filename) {
+	Common::File f;
+	if (!f.open(filename))
+		return false;
+
+	char magic[5] = { 0 };
+	f.read(magic, 4);
+	if (strcmp(magic, CHT_FONT_MAGIC) != 0) {
+		warning("[CHT] %s 不是 RXCF 字型檔", filename.c_str());
+		return false;
+	}
+
+	_glyphW = f.readByte();
+	_glyphH = f.readByte();
+	_count = f.readUint16LE();
+	if (_glyphW == 0 || _glyphH == 0 || _count == 0) {
+		warning("[CHT] %s 標頭不合理 (%dx%d, %d 字)", filename.c_str(), _glyphW, _glyphH, _count);
+		return false;
+	}
+	_bytesPerRow = (_glyphW + 7) / 8;
+
+	_codes = new uint16[_count];
+	for (uint16 i = 0; i < _count; ++i)
+		_codes[i] = f.readUint16LE();
+
+	const uint32 stride = (uint32)_bytesPerRow * _glyphH;
+	_glyphs = new byte[(size_t)stride * _count];
+	f.read(_glyphs, (uint32)stride * _count);
+	f.close();
+	return true;
+}
+
+bool ChtSupport::loadTable(const Common::String &filename) {
+	Common::File f;
+	if (!f.open(filename))
+		return false;
+
+	while (!f.eos()) {
+		Common::String line = f.readLine();
+		if (line.empty() || line.hasPrefix("#"))
+			continue;
+
+		// key <TAB> 譯文
+		uint32 tab = line.findFirstOf('\t');
+		if (tab == Common::String::npos)
+			continue;
+		Common::String key = Common::String(line.c_str(), tab);
+		Common::String value = Common::String(line.c_str() + tab + 1);
+		if (key.empty() || value.empty())
+			continue;
+
+		_table[key] = value;
+	}
+
+	f.close();
+	return !_table.empty();
+}
+
+const byte *ChtSupport::glyph(uint16 big5Code) const {
+	if (!_enabled && _count == 0)
+		return nullptr;
+
+	// _codes 是排序過的，二分搜尋
+	int lo = 0, hi = (int)_count - 1;
+	while (lo <= hi) {
+		const int mid = (lo + hi) / 2;
+		if (_codes[mid] == big5Code)
+			return _glyphs + (size_t)mid * _bytesPerRow * _glyphH;
+		if (_codes[mid] < big5Code)
+			lo = mid + 1;
+		else
+			hi = mid - 1;
+	}
+	return nullptr;
+}
+
+const Common::String *ChtSupport::lookup(const Common::String &key) const {
+	Common::HashMap<Common::String, Common::String>::const_iterator it = _table.find(key);
+	if (it == _table.end())
+		return nullptr;
+	return &it->_value;
+}
+
+const char *ChtSupport::big5Strchr(const char *s, char c, bool chtOn) {
+	if (!chtOn)
+		return strchr(s, c);
+
+	while (*s) {
+		if ((byte)*s >= 0xA1 && *(s + 1)) {
+			s += 2;            // 雙位元組字：整個跳過，不看它的 trail byte
+			continue;
+		}
+		if (*s == c)
+			return s;
+		++s;
+	}
+	return nullptr;
+}
+
+// 逐字元走過字串，對 ASCII 位元組套用 fn，雙位元組字整個跳過。
+// 這是「許功蓋問題」在大小寫轉換上的修法：中文沒有大小寫，
+// 而 Big5 的 trail byte 大量落在 A-Z / a-z，逐 byte 轉換會把字改掉。
+static void big5MapAscii(Common::String &s, int (*fn)(int), bool chtOn) {
+	if (!chtOn) {
+		for (uint i = 0; i < s.size(); ++i)
+			s.setChar((char)fn((byte)s[i]), i);
+		return;
+	}
+
+	for (uint i = 0; i < s.size(); ) {
+		if ((byte)s[i] >= 0xA1 && i + 1 < s.size()) {
+			i += 2;            // 雙位元組字：原樣保留
+			continue;
+		}
+		s.setChar((char)fn((byte)s[i]), i);
+		++i;
+	}
+}
+
+void ChtSupport::big5ToUppercase(Common::String &s, bool chtOn) {
+	big5MapAscii(s, toupper, chtOn);
+}
+
+void ChtSupport::big5ToLowercase(Common::String &s, bool chtOn) {
+	big5MapAscii(s, tolower, chtOn);
+}
+
+void ChtSupport::big5CapitalizeFirst(Common::String &s, bool chtOn) {
+	if (s.empty())
+		return;
+	// Big5 lead byte 開頭就不動：中文沒有大小寫，而且 char 是 signed，
+	// 把 ≥0x80 的值傳給 toupper() 是未定義行為。
+	if (chtOn && (byte)s[0] >= 0xA1)
+		return;
+	s.setChar((char)toupper((byte)s[0]), 0);
+}
+
+bool ChtSupport::big5EndsWithChar(const Common::String &s, char c, bool chtOn) {
+	if (s.empty())
+		return false;
+	if (!chtOn)
+		return s[s.size() - 1] == c;
+
+	// 從頭走一次才知道最後一個位元組是獨立的 ASCII 字元，還是某個雙位元組字的
+	// trail byte。只看最後一格是分不出來的 —— 「快存」= A7 D6 A6 73 的結尾
+	// 剛好是 's'。
+	uint last = 0;
+	bool lastIsWide = false;
+	for (uint i = 0; i < s.size(); ) {
+		last = i;
+		if ((byte)s[i] >= 0xA1 && i + 1 < s.size()) {
+			lastIsWide = true;
+			i += 2;
+		} else {
+			lastIsWide = false;
+			++i;
+		}
+	}
+	return !lastIsWide && s[last] == c;
+}
+
+bool ChtSupport::big5StartsWide(const Common::String &s, bool chtOn) {
+	return chtOn && !s.empty() && (byte)s[0] >= 0xA1;
+}
+
+int ChtSupport::drawToLayer(Screen *screen, int x320, int y320,
+		const Common::String &text, byte color) const {
+	if (!_enabled || !screen)
+		return x320;
+
+	Graphics::Surface *layer = screen->chtLayer();
+	Graphics::Surface *mask = screen->chtMask();
+	// 文字層是在 Screen 建構之後才配置的。主選單比一般場景早很多，
+	// 沒有這道檢查就會在還沒配置時寫進 null pixels。
+	if (!layer || !mask || !layer->getPixels() || !mask->getPixels()) {
+		debug(2, "[CHT] drawToLayer：文字層尚未配置，略過");
+		return x320;
+	}
+	const int scale = MADS_DISPLAY_SCALE;
+	const int logicalW = _glyphW / scale;      // 一個字在 320 空間佔的寬度
+
+	const char *p = text.c_str();
+	int x = x320;
+	while (*p) {
+		if ((byte)p[0] >= 0xA1 && (byte)p[1] >= 0x40) {
+			const uint16 code = ((byte)p[0] << 8) | (byte)p[1];
+			const byte *g = glyph(code);
+			const int ax = x * scale, ay = y320 * scale;
+
+			if (ax + _glyphW > layer->w)
+				break;                          // 畫不下就停，不要畫出畫面外
+
+			if (g) {
+				// 先清這一格：主選單會重畫，同位置疊字會糊成一團
+				const Common::Rect cell(x, y320, x + logicalW,
+					y320 + (_glyphH + scale - 1) / scale);
+				screen->chtClear(cell);
+				screen->chtTouch(cell);
+
+				for (int row = 0; row < _glyphH; ++row) {
+					const int ly = ay + row;
+					if (ly < 0 || ly >= layer->h)
+						continue;
+					byte *dstP = (byte *)layer->getBasePtr(0, ly);
+					byte *maskP = (byte *)mask->getBasePtr(0, ly);
+					const byte *rowP = g + (size_t)row * _bytesPerRow;
+					for (int col = 0; col < _glyphW; ++col) {
+						const int lx = ax + col;
+						if (lx < 0 || lx >= layer->w)
+							continue;
+						if (rowP[col >> 3] & (0x80 >> (col & 7))) {
+							dstP[lx] = color;
+							maskP[lx] = 1;      // 顏色可能是 0，得靠遮罩才知道有字
+						}
+					}
+				}
+			}
+			x += logicalW;
+			p += 2;
+		} else {
+			// 主選單的譯名理論上全是中文，但 ASCII 混進來時不要當成半個中文字
+			// 而把後面整串吃掉 —— 直接跳過一個位元組。
+			++p;
+		}
+	}
+	return x;
+}
+
+bool ChtSupport::hasWideChar(const Common::String &s) {
+	for (uint i = 0; i < s.size(); ++i) {
+		if ((byte)s[i] >= 0xA1)
+			return true;
+	}
+	return false;
+}
+
+} // End of namespace MADS
