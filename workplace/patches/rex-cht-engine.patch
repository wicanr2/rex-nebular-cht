+void Screen::copyRectScaled(const Common::Rect &r) {
+	const int scale = MADS_DISPLAY_SCALE;
+	const int dw = r.width() * scale;
+	const int dh = r.height() * scale;
+	if (dw <= 0 || dh <= 0)
+		return;
+
+	byte *tmp = new byte[dw * dh];
+	for (int y = 0; y < dh; ++y) {
+		const byte *srcP = (const byte *)getBasePtr(r.left, r.top + y / scale);
+		byte *dstP = tmp + (size_t)y * dw;
+		for (int x = 0; x < r.width(); ++x) {
+			const byte v = srcP[x];
+			for (int s = 0; s < scale; ++s)
+				*dstP++ = v;
+		}
+	}
+
+	// [CHT] 疊上中文文字層（原生解析度，非 0 即不透明）
+	const int ox = r.left * scale;
+	const int oy = r.top * scale;
+	for (int y = 0; y < dh; ++y) {
+		const int ly = oy + y;
+		if (ly < 0 || ly >= _chtLayer.h)
+			continue;
+		const byte *layerP = (const byte *)_chtLayer.getBasePtr(0, ly);
+		const byte *maskP = (const byte *)_chtMask.getBasePtr(0, ly);
+		byte *dstP = tmp + (size_t)y * dw;
+		for (int x = 0; x < dw; ++x) {
