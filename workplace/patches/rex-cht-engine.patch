+ * GNU General Public License for more details.
+ *
+ * You should have received a copy of the GNU General Public License
+ * along with this program.  If not, see <http://www.gnu.org/licenses/>.
+ *
+ */
+
+#include "common/file.h"
+#include "common/textconsole.h"
+#include "common/debug.h"
+#include "mads/cht.h"
+
+namespace MADS {
+
+#define CHT_FONT_FILE  "rex_big5.fnt"
+#define CHT_TABLE_FILE "rex_cht.tsv"
+#define CHT_FONT_MAGIC "RXCF"
+
+ChtSupport::ChtSupport() : _enabled(false), _glyphW(0), _glyphH(0), _bytesPerRow(0),
+		_count(0), _codes(nullptr), _glyphs(nullptr) {
+}
+
+ChtSupport::~ChtSupport() {
+	delete[] _codes;
+	delete[] _glyphs;
+}
+
+bool ChtSupport::load() {
+	if (!loadFont(CHT_FONT_FILE)) {
+		// 沒有中文字型就是玩家沒裝中文化，維持英文，不是錯誤
+		return false;
+	}
+	if (!loadTable(CHT_TABLE_FILE)) {
+		warning("[CHT] 找到 %s 卻讀不到 %s，維持英文", CHT_FONT_FILE, CHT_TABLE_FILE);
+		return false;
+	}
+
+	_enabled = true;
+	debug(1, "[CHT] 中文化啟用：字型 %d 字 (%dx%d)，替換表 %d 筆",
+		_count, _glyphW, _glyphH, _table.size());
+	return true;
+}
+
+bool ChtSupport::loadFont(const Common::String &filename) {
+	Common::File f;
+	if (!f.open(filename))
+		return false;
+
+	char magic[5] = { 0 };
+	f.read(magic, 4);
+	if (strcmp(magic, CHT_FONT_MAGIC) != 0) {
+		warning("[CHT] %s 不是 RXCF 字型檔", filename.c_str());
+		return false;
+	}
+
+	_glyphW = f.readByte();
+	_glyphH = f.readByte();
+	_count = f.readUint16LE();
+	if (_glyphW == 0 || _glyphH == 0 || _count == 0) {
+		warning("[CHT] %s 標頭不合理 (%dx%d, %d 字)", filename.c_str(), _glyphW, _glyphH, _count);
+		return false;
+	}
+	_bytesPerRow = (_glyphW + 7) / 8;
+
+	_codes = new uint16[_count];
+	for (uint16 i = 0; i < _count; ++i)
+		_codes[i] = f.readUint16LE();
+
+	const uint32 stride = (uint32)_bytesPerRow * _glyphH;
+	_glyphs = new byte[(size_t)stride * _count];
+	f.read(_glyphs, (uint32)stride * _count);
+	f.close();
+	return true;
+}
+
+bool ChtSupport::loadTable(const Common::String &filename) {
+	Common::File f;
+	if (!f.open(filename))
+		return false;
+
+	while (!f.eos()) {
+		Common::String line = f.readLine();
+		if (line.empty() || line.hasPrefix("#"))
+			continue;
+
+		// key <TAB> 譯文
+		uint32 tab = line.findFirstOf('\t');
+		if (tab == Common::String::npos)
+			continue;
+		Common::String key = Common::String(line.c_str(), tab);
+		Common::String value = Common::String(line.c_str() + tab + 1);
+		if (key.empty() || value.empty())
+			continue;
+
+		_table[key] = value;
+	}
+
+	f.close();
+	return !_table.empty();
+}
+
+const byte *ChtSupport::glyph(uint16 big5Code) const {
+	if (!_enabled && _count == 0)
+		return nullptr;
+
+	// _codes 是排序過的，二分搜尋
+	int lo = 0, hi = (int)_count - 1;
+	while (lo <= hi) {
+		const int mid = (lo + hi) / 2;
+		if (_codes[mid] == big5Code)
+			return _glyphs + (size_t)mid * _bytesPerRow * _glyphH;
+		if (_codes[mid] < big5Code)
+			lo = mid + 1;
+		else
+			hi = mid - 1;
+	}
+	return nullptr;
+}
+
+const Common::String *ChtSupport::lookup(const Common::String &key) const {
+	Common::HashMap<Common::String, Common::String>::const_iterator it = _table.find(key);
+	if (it == _table.end())
+		return nullptr;
+	return &it->_value;
+}
+
+const char *ChtSupport::big5Strchr(const char *s, char c, bool chtOn) {
+	if (!chtOn)
+		return strchr(s, c);
+
+	while (*s) {
+		if ((byte)*s >= 0xA1 && *(s + 1)) {
+			s += 2;            // 雙位元組字：整個跳過，不看它的 trail byte
+			continue;
+		}
+		if (*s == c)
+			return s;
+		++s;
+	}
+	return nullptr;
+}
+
+bool ChtSupport::hasWideChar(const Common::String &s) {
+	for (uint i = 0; i < s.size(); ++i) {
+		if ((byte)s[i] >= 0xA1)
+			return true;
+	}
+	return false;
+}
+
+} // End of namespace MADS
