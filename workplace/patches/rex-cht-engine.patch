+
+#ifndef MADS_CHT_H
+#define MADS_CHT_H
+
+// [CHT] 繁體中文化支援：Big5 點陣字庫 + 文字替換表。
+//
+// 啟用方式是「遊戲目錄有沒有 rex_big5.fnt + rex_cht.tsv」，不是 --language ——
+// MADS 的 detection table 全部是 EN_ANY，設非英文語言會改變 detector 行為。
+// 兩個檔案任一個開不起來就維持英文原樣，玩家什麼都不會發現。
+
+#include "common/scummsys.h"
+#include "common/str.h"
+#include "common/hashmap.h"
+#include "common/hash-str.h"
+
+namespace MADS {
+
+class ChtSupport {
+private:
+	bool _enabled;
+	byte _glyphW, _glyphH, _bytesPerRow;
+	uint16 _count;
+	uint16 *_codes;      // 已排序的 Big5 碼，供二分搜尋
+	byte *_glyphs;       // count × (bytesPerRow × glyphH)
+	Common::HashMap<Common::String, Common::String> _table;
+
+	bool loadFont(const Common::String &filename);
+	bool loadTable(const Common::String &filename);
+public:
+	ChtSupport();
+	~ChtSupport();
+
+	/**
+	 * 載入字型與替換表；任一失敗則維持停用狀態並回傳 false
+	 */
+	bool load();
+
+	bool enabled() const { return _enabled; }
+	int glyphWidth() const { return _glyphW; }
+	int glyphHeight() const { return _glyphH; }
+	int bytesPerRow() const { return _bytesPerRow; }
+
+	/**
+	 * 取 Big5 字模；找不到回 nullptr（畫面上會是空白，代表字型沒烘到那個字）
+	 */
+	const byte *glyph(uint16 big5Code) const;
+
+	/**
+	 * 查替換表。key 形如 "quote:301"、"vocab:38"、"msg:2"。
+	 * 查無則回 nullptr（呼叫端就照原本的英文走）
+	 */
+	const Common::String *lookup(const Common::String &key) const;
+
+	/**
+	 * 這個字串裡有沒有雙位元組字（決定要不要用中文行高）
+	 */
+	static bool hasWideChar(const Common::String &s);
+
+	/**
+	 * Big5 安全版 strchr：掃描時跳過雙位元組字的 trail byte。
+	 *
+	 * Big5 的 trail byte 落在 '@'(0x40)、'['(0x5B)、'\\'(0x5C)、']'(0x5D) 這些
+	 * ASCII 值上很常見（「作」= A7 40、「一」= A4 40），原版的逐 byte strchr()
+	 * 會在中文字的第二個位元組上誤中，把字從中間切開。
+	 * chtOn 為 false 時行為與 strchr() 完全相同。
+	 */
+	static const char *big5Strchr(const char *s, char c, bool chtOn);
+
